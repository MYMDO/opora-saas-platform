{
  "name": "@opora/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create opora-db",
    "db:migrate:local": "wrangler d1 migrations apply opora-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply opora-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.125.0"
  }
}
