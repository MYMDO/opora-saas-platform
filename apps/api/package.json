{
  "name": "@opora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create opora-core-db",
    "db:migrate:local": "wrangler d1 migrations apply opora-core-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply opora-core-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opora/dsl": "workspace:^",
    "@opora/data-runtime": "workspace:^",
    "@opora/metadata": "workspace:^",
    "hono": "^4.6.0",
    "@opora/workflow": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.0.0",
    "@cloudflare/workers-types": "^5.20260820.0",
    "wrangler": "^4.125.0"
  }
}
